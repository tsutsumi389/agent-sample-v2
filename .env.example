# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=agentdb

# Backend
# 注意: LangGraph の Postgres 実装は psycopg3 を使うため postgresql:// を使用（+psycopg2 を付けない）
DATABASE_URL=postgresql://app:app@db:5432/agentdb

# ホストで起動している Ollama へコンテナから接続
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=gemma4:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# nomic-embed-text の埋め込み次元（store の index.dims と一致させる）
EMBED_DIMS=768
